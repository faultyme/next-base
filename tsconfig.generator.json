{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./generator/dist",
    "rootDir": "./generator",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["generator/**/*.ts"],
  "exclude": ["generator/templates"]
}
